{
  "name": "deck-to-svg",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "dist-tsc/index.js",
  "publishConfig": {
    "main": "dist/index.js",
    "module": "dist/index.js",
    "exports": {
      ".": {
        "types": "./dist-tsc/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "dist-tsc"
  ],
  "scripts": {
    "start": "pnpm -C ../ run start-tsc",
    "build": "pnpm -C ../ run build-tsc",
    "bundle": "pnpm exec vite build -c ../scripts/vite.config.js",
    "test": "pnpm exec vitest --run -r ../ --dir ."
  },
  "dependencies": {
    "d3": "^7.5.0",
    "d3-selection": "^3.0.0",
    "d3-format": "^3.1.0",
    "d3-scale": "^4.0.2",
    "d3-axis": "^3.0.0",
    "d3-array": "^3.2.4",
    "lodash-es": "^4.17.21",
    "vega-scale": "6.0.0"
  },
  "devDependencies": {
    "@deck.gl/core": "^9.1.14",
    "@deck.gl/layers": "^9.1.14",
    "vitest": "^3.2.4",
    "vite": "^6.1.1",
    "jsdom": "^26.1.0",
    "vitest-canvas-mock": "^0.3.3",
    "typescript": "^5.9"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0"
  }
}
